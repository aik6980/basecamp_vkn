{
  "files.associations": {
    "*.hlsl": "hlsl",
    "*.cs.hlsl": "hlsl",
    "*.ps.hlsl": "hlsl",
    "*.vs.hlsl": "hlsl",
    "*.ray.hlsl": "hlsl",
    "*.ras.hlsl": "hlsl"
  },
  "[hlsl]": {
    "editor.defaultFormatter": "moowiz.clang-format-moowiz-fork",
    "editor.formatOnSave": false
  },
  "clang-format.style": "file",
  "clang-format.fallbackStyle": "LLVM"
}